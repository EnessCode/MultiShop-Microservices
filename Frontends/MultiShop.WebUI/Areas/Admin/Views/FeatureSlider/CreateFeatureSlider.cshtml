@model CreateFeatureSliderDto

@{
    ViewData["Title"] = "Yeni Görsel Ekle";
}

<section class="content container-fluid" style="padding: 0;">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">

                <div style="margin-bottom: 25px;">
                    <p style="color: #5e6e82; font-size: 14px; margin: 0;">Ana sayfada gösterilecek yeni bir vitrin görseli ve kampanya metni tanımlayınız.</p>
                </div>

                <form method="post" action="/Admin/FeatureSlider/CreateFeatureSlider">

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label style="font-weight: 500; color: #495057; margin-bottom: 8px;">Başlık</label>
                        <input type="text" class="form-control" asp-for="Title" required placeholder="Örn: %50'ye Varan Yaz İndirimleri" style="border-radius: 6px; border: 1px solid #edf2f9; padding: 10px 15px; box-shadow: none;" />
                    </div>

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label style="font-weight: 500; color: #495057; margin-bottom: 8px;">Görsel URL</label>
                        <input type="text" class="form-control" asp-for="ImageUrl" id="ImageUrl" oninput="updatePreview()" required placeholder="Örn: https://.../slider1.jpg" style="border-radius: 6px; border: 1px solid #edf2f9; padding: 10px 15px; box-shadow: none;" />

                        <div style="margin-top: 15px;">
                            <p style="font-size: 13px; color: #6c757d; margin-bottom: 5px;"><i class="fa fa-image"></i> Görsel Ön İzleme</p>
                            <img id="imagePreview" src="" alt="Önizleme" style="max-width: 100%; height: 200px; object-fit: cover; border-radius: 6px; border: 1px dashed #ced4da; display: none; padding: 4px;" />
                        </div>
                    </div>

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label style="font-weight: 500; color: #495057; margin-bottom: 8px;">Açıklama (Alt Metin)</label>
                        <textarea class="form-control" asp-for="Description" rows="3" placeholder="Görselin altında yer alacak kısa açıklama..." style="border-radius: 6px; border: 1px solid #edf2f9; padding: 10px 15px; box-shadow: none;"></textarea>
                    </div>

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label style="font-weight: 500; color: #495057; margin-bottom: 8px;">Yayın Durumu</label>
                        <select class="form-control" asp-for="IsActive" style="border-radius: 6px; border: 1px solid #edf2f9; padding: 10px 15px; box-shadow: none; height: auto;">
                            <option value="true">Aktif (Sitede Gösterilsin)</option>
                            <option value="false">Pasif (Gizlensin)</option>
                        </select>
                    </div>

                    <div style="margin-top: 30px;">
                        <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Slider'ı Kaydet</button>
                        <a href="/Admin/FeatureSlider/Index" class="btn btn-danger" style="margin-left: 10px;"><i class="fa fa-times"></i> İptal</a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</section>

<script>
    function updatePreview() {
        var url = document.getElementById('ImageUrl').value;
        var preview = document.getElementById('imagePreview');
        if (url) {
            preview.src = url;
            preview.style.display = 'block';
        } else {
            preview.src = '';
            preview.style.display = 'none';
        }
    }
</script>