@model CreateBrandDto

@{
    ViewData["Title"] = "Yeni Marka Ekle";
}

<section class="content container-fluid" style="padding: 0;">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">

                <div style="margin-bottom: 25px;">
                    <p style="color: #5e6e82; font-size: 14px; margin: 0;">Sisteme tanımlanacak yeni markanın bilgilerini giriniz.</p>
                </div>

                <form method="post" action="/Admin/Brand/CreateBrand">
                    <div class="form-group" style="margin-bottom: 20px;">
                        <label style="font-weight: 500; color: #495057; margin-bottom: 8px;">Marka Adı</label>
                        <input type="text" class="form-control" asp-for="Name" required placeholder="Örn: Nike" style="border-radius: 6px; border: 1px solid #edf2f9; padding: 10px 15px; box-shadow: none;" />
                    </div>

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label style="font-weight: 500; color: #495057; margin-bottom: 8px;">Marka Logo Bağlantısı (URL)</label>
                        <input type="text" class="form-control" asp-for="ImageUrl" id="ImageUrl" oninput="updatePreview()" required placeholder="Örn: https://.../logo.png" style="border-radius: 6px; border: 1px solid #edf2f9; padding: 10px 15px; box-shadow: none;" />

                        <div style="margin-top: 15px;">
                            <p style="font-size: 13px; color: #6c757d; margin-bottom: 5px;"><i class="fa fa-image"></i> Logo Ön İzleme</p>
                            <img id="imagePreview" src="" alt="Önizleme" style="max-width: 100%; height: 120px; object-fit: contain; border-radius: 6px; border: 1px dashed #ced4da; display: none; padding: 10px; background-color: #fff;" />
                        </div>
                    </div>

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label style="font-weight: 500; color: #495057; margin-bottom: 8px;">Yayın Durumu</label>
                        <select class="form-control" asp-for="IsActive" style="border-radius: 6px; border: 1px solid #edf2f9; padding: 10px 15px; box-shadow: none; height: auto;">
                            <option value="true">Aktif (Ana Sayfada Gösterilsin)</option>
                            <option value="false">Pasif (Gizlensin)</option>
                        </select>
                    </div>

                    <div style="margin-top: 30px;">
                        <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Markayı Kaydet</button>
                        <a href="/Admin/Brand/Index" class="btn btn-danger" style="margin-left: 10px;"><i class="fa fa-times"></i> İptal</a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</section>

<script>
    function updatePreview() {
        var url = document.getElementById('ImageUrl').value;
        var preview = document.getElementById('imagePreview');
        if (url) {
            preview.src = url;
            preview.style.display = 'block';
        } else {
            preview.src = '';
            preview.style.display = 'none';
        }
    }
</script>