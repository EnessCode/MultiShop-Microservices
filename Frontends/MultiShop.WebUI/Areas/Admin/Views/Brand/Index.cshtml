@model List<ResultBrandDto>

@{
    ViewData["Title"] = "Marka Yönetimi";
    int count = 0;
}

<section class="content container-fluid" style="padding: 0;">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">

                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; flex-wrap: wrap; gap: 10px;">
                    <p style="color: #5e6e82; font-size: 14px; margin: 0;">
                        Ana sayfa ve referanslar bölümünde listelenen iş ortaklarınızın logolarını yönetin.
                    </p>
                    <a href="/Admin/Brand/CreateBrand" class="btn btn-primary">
                        <i class="fa fa-plus"></i> Yeni Marka Ekle
                    </a>
                </div>

                <div class="alert alert-info" role="alert" style="border-radius: 6px; border-left: 4px solid #b8daff; background-color: #e8f4fd; color: #0056b3; font-size: 13px; margin-bottom: 20px; padding: 10px 15px;">
                    <i class="fa fa-info-circle" style="font-size: 14px; margin-right: 5px;"></i>
                    <strong>Sistem Notu:</strong> Sadece durumu <strong>"Aktif"</strong> olan markalar ana sayfada listelenir.
                </div>

                @if (Model != null && Model.Count > 0)
                {
                    <div class="bs-example" data-example-id="bordered-table">
                        <table class="table table-bordered table-striped" id="brandTable" data-sort-asc="false">
                            <thead>
                                <tr>
                                    <th style="width: 70px; text-align: center;">#</th>
                                    <th style="width: 150px; text-align: center;">Marka Logosu</th>
                                    <th>Marka Adı</th>

                                    <th class="sortable-header" style="width: 120px; text-align: center;" onclick="sortTableByStatus('brandTable')">
                                        Durum <i class="fa fa-sort"></i>
                                    </th>

                                    <th style="width: 100px; text-align: center;">Sil</th>
                                    <th style="width: 100px; text-align: center;">Güncelle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderByDescending(x => x.IsActive))
                                {
                                    count++;
                                    <tr data-status="@(item.IsActive ? 1 : 0)">
                                        <th scope="row" style="text-align: center; vertical-align: middle;">@count</th>
                                        <td style="text-align: center; vertical-align: middle;">
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl" alt="@item.Name" style="width: 100px; height: 50px; object-fit: contain; border-radius: 4px; border: 1px solid #edf2f9; background-color: #fff;" />
                                            }
                                            else
                                            {
                                                <div style="width: 100px; height: 50px; background-color: #f8f9fa; border-radius: 4px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid #edf2f9;">
                                                    <i class="fa fa-image text-muted" style="font-size: 16px;"></i>
                                                </div>
                                            }
                                        </td>
                                        <td style="font-weight: 600; color: #333; vertical-align: middle;">@item.Name</td>
                                        <td style="text-align: center; vertical-align: middle;">
                                            @if (item.IsActive)
                                            {
                                                <span class="badge" style="background-color: #28a745; padding: 6px 12px; border-radius: 4px;">Aktif</span>
                                            }
                                            else
                                            {
                                                <span class="badge" style="background-color: #6c757d; padding: 6px 12px; border-radius: 4px;">Pasif</span>
                                            }
                                        </td>
                                        <td style="text-align: center; vertical-align: middle;">
                                            <a href="/Admin/Brand/DeleteBrand/@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('@item.Name markasını silmek istediğinize emin misiniz?');">
                                                <i class="fa fa-trash"></i> Sil
                                            </a>
                                        </td>
                                        <td style="text-align: center; vertical-align: middle;">
                                            <a href="/Admin/Brand/UpdateBrand/@item.Id" class="btn btn-warning btn-sm">
                                                <i class="fa fa-edit"></i> Güncelle
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning" role="alert" style="border-radius: 8px; margin-bottom: 0;">
                        Sistemde henüz kayıtlı bir marka veya referans bulunmuyor.
                    </div>
                }

            </div>
        </div>
    </div>
</section>