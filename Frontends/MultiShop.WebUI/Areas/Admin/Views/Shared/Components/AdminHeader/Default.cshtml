<header class="main-header">
    <a href="/Admin/Dashboard/Index" class="logo" style="text-decoration: none;">
        <span class="logo-mini"><i class="fa fa-shopping-cart" style="color: #f39c12;"></i></span>
        <span class="logo-lg" style="font-weight: 600; letter-spacing: 1px; color: #fff;">
            <i class="fa fa-shopping-cart" style="color: #f39c12; margin-right: 5px;"></i> Multi<span style="color: #f39c12;">Shop</span>
        </span>
    </a>

    <nav class="navbar navbar-static-top" role="navigation">
        <a href="#" class="sidebar-toggle" data-toggle="push-menu" role="button">
            <i class="fa fa-bars"></i>
            <span class="sr-only">Navigasyonu Değiştir</span>
        </a>

        <div class="pull-left search-box" style="margin-top: 8px; margin-left: 15px;">
            <form action="#" method="get" class="search-form">
                <div class="input-group" style="background: #f4f6f9; border-radius: 20px; padding: 2px 10px;">
                    <input type="text" name="search" class="form-control" placeholder="Sistemde Ara..." style="border: none; background: transparent; box-shadow: none;">
                    <span class="input-group-btn">
                        <button type="submit" name="search" id="search-btn" class="btn btn-flat" style="background: transparent; color: #a1a5b7;"><i class="fa fa-search"></i> </button>
                    </span>
                </div>
            </form>
        </div>

        <div class="navbar-custom-menu">
            <ul class="nav navbar-nav">

                <li class="dropdown messages-menu">
                    <a href="#" class="dropdown-toggle" data-toggle="dropdown" style="color: #5e6e82;">
                        <i class="fa fa-envelope-o"></i>
                        @if (ViewBag.MessageCount > 0)
                        {
                            <span class="label label-success">@ViewBag.MessageCount</span>
                        }
                    </a>
                    <ul class="dropdown-menu" style="border-radius: 8px; box-shadow: 0 5px 15px rgba(0,0,0,0.1); border: none; width: 280px;">
                        <li class="header" style="background: #fff; font-weight: 600; border-bottom: 1px solid #f4f6f9; padding: 10px 15px;">
                            Sizi Bekleyen @ViewBag.MessageCount Mesaj Var
                        </li>
                        <li>
                            <ul class="menu" style="list-style: none; padding: 0; margin: 0;">
                                <li>
                                    <a href="/Admin/Message/Index" style="color: #5e6e82; display: flex; align-items: center; padding: 10px 15px; border-bottom: 1px solid #f9f9f9; text-decoration: none;">
                                        <div style="background-color: #007bff; color: #fff; width: 35px; height: 35px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 600; margin-right: 15px; flex-shrink: 0;">
                                            <i class="fa fa-inbox"></i>
                                        </div>
                                        <div>
                                            <h4 style="margin: 0 0 3px 0; font-size: 13px; font-weight: 600; color: #333;">Gelen Kutusu</h4>
                                            <p style="margin: 0; font-size: 12px; color: #888;">Mesajlarınızı detaylı görüntüleyin.</p>
                                        </div>
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="footer" style="text-align: center; padding: 10px; background-color: #fdfdfd; border-radius: 0 0 8px 8px;">
                            <a href="/Admin/Message/Index" style="font-weight: 600; color: #007bff; font-size: 13px; text-decoration: none;">Tüm Mesajlara Git</a>
                        </li>
                    </ul>
                </li>

                <li class="dropdown notifications-menu">
                    <a href="#" class="dropdown-toggle" data-toggle="dropdown" style="color: #5e6e82;">
                        <i class="fa fa-bell-o"></i>
                        @if (ViewBag.CommentCount > 0)
                        {
                            <span class="label label-warning">@ViewBag.CommentCount</span>
                        }
                    </a>
                    <ul class="dropdown-menu" style="border-radius: 8px; box-shadow: 0 5px 15px rgba(0,0,0,0.1); border: none;">
                        <li class="header" style="background: #fff; font-weight: 600; border-bottom: 1px solid #f4f6f9;">Sistem Bildirimleri</li>
                        <li>
                            <ul class="menu">
                                @if (ViewBag.CommentCount > 0)
                                {
                                    <li>
                                        <a href="/Admin/Comment/Index" style="color: #5e6e82;">
                                            <i class="fa fa-commenting text-warning"></i> Onay bekleyen @ViewBag.CommentCount yeni yorum var.
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li>
                                        <a href="/Admin/Comment/Index" style="color: #5e6e82;">
                                            <i class="fa fa-check-circle text-success"></i> Bekleyen yeni yorum yok.
                                        </a>
                                    </li>
                                }
                                <li><a href="#" style="color: #5e6e82;"><i class="fa fa-shopping-basket text-info"></i> Sipariş altyapısı aktif.</a></li>
                            </ul>
                        </li>
                    </ul>
                </li>

                <li class="dropdown user user-menu">
                    <a href="#" class="dropdown-toggle" data-toggle="dropdown" style="color: #5e6e82; display: flex; align-items: center; gap: 10px;">
                        <div style="background-color: #f39c12; color: #fff; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 14px;">A</div>
                        <span class="hidden-xs" style="font-weight: 500;">Admin</span>
                    </a>
                    <ul class="dropdown-menu" style="border-radius: 8px; box-shadow: 0 5px 15px rgba(0,0,0,0.1); border: none;">
                        <li class="user-header" style="background-color: #f4f6f9; color: #333;">
                            <div style="background-color: #f39c12; color: #fff; width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: bold; margin: 10px auto;">A</div>
                            <p style="font-weight: 600; color: #1e1e2d;">Admin <small style="color: #6c757d; font-weight: 400;">Sistem Yöneticisi</small> </p>
                        </li>
                        <li><a href="#"><i class="fa fa-user-o"></i> Profilim</a></li>
                        <li><a href="#"><i class="fa fa-cog"></i> Ayarlar</a></li>
                        <li role="separator" class="divider"></li>
                        <li><a href="#" style="color: #e74c3c;"><i class="fa fa-sign-out"></i> Çıkış Yap</a></li>
                    </ul>
                </li>
            </ul>
        </div>
    </nav>
</header>