<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>MultiShop | Admin Paneli</title>

    <link rel="stylesheet" href="~/MainDownload-OvioAdmin-html5-template/html/bootstrap/css/bootstrap.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/MainDownload-OvioAdmin-html5-template/html/dist/css/style.css">
    <link rel="stylesheet" href="~/MainDownload-OvioAdmin-html5-template/html/tables/et-line-font/et-line-font.css">
    <link rel="stylesheet" href="~/MainDownload-OvioAdmin-html5-template/html/tables/font-awesome/css/font-awesome.min.css">
    <link type="text/css" rel="stylesheet" href="~/MainDownload-OvioAdmin-html5-template/html/dist/weather/weather-icons.min.css">
    <link type="text/css" rel="stylesheet" href="~/MainDownload-OvioAdmin-html5-template/html/dist/weather/weather-icons-wind.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

    <style>
        body {
            background-color: #f4f6f9;
            font-family: 'Poppins', sans-serif;
        }

        .content-wrapper {
            background-color: #f4f6f9;
            min-height: 100vh;
        }

        .chart-box {
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            border: none;
            padding: 20px;
            margin-bottom: 20px;
        }

        .table {
            border-radius: 8px;
            overflow: hidden;
            margin-bottom: 0;
            border: 1px solid #edf2f9;
        }

            .table thead th {
                background-color: #f8f9fa;
                border-bottom: 1px solid #edf2f9 !important;
                color: #495057;
                font-weight: 600;
                text-transform: uppercase;
                font-size: 13px;
            }

            .table tbody td {
                vertical-align: middle;
                border-color: #edf2f9;
                color: #5e6e82;
                font-size: 14px;
            }

        .btn {
            border-radius: 6px;
            font-weight: 500;
            transition: all 0.2s ease;
            padding: 6px 14px;
        }

        .btn-primary {
            background-color: #4361ee;
            border-color: #4361ee;
        }

            .btn-primary:hover {
                background-color: #3a56d4;
            }

        .btn-warning {
            background-color: #f39c12;
            color: white;
            border: none;
        }

        .btn-danger {
            background-color: #e74c3c;
            border: none;
        }

        .main-header {
            background-color: #1e1e2d;
            border: none;
            box-shadow: none;
        }

        .navbar-static-top {
            background-color: #ffffff;
            box-shadow: 0 1px 5px rgba(0,0,0,0.05);
        }

        .logo {
            background-color: #1e1e2d !important;
            border-bottom: none !important;
            height: 60px !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            padding: 0 !important;
            margin: 0 !important;
            text-decoration: none !important;
        }

            .logo span {
                vertical-align: middle;
            }

        .main-sidebar {
            background-color: #1e1e2d;
        }

        .sidebar-menu li a {
            color: #a2a3b7;
            padding: 12px 20px;
            transition: 0.2s;
            font-size: 14px;
        }

            .sidebar-menu li a:hover, .sidebar-menu li.active a {
                background-color: #1b1b28;
                color: #ffffff;
                border-left: 3px solid #f39c12;
            }

        .sidebar-toggle {
            color: #1e1e2d !important;
        }
    </style>
</head>