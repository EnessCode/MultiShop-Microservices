@model List<ResultCargoCompanyDto>

@{
    ViewData["Title"] = "Kargo Firmaları";
    int count = 0;
}

<section class="content container-fluid" style="padding: 0;">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">

                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; flex-wrap: wrap; gap: 10px;">
                    <p style="color: #5e6e82; font-size: 14px; margin: 0;">
                        Sisteme kayıtlı kargo firmalarını buradan yönetebilirsiniz.
                    </p>

                    <a href="/Admin/Cargo/CreateCargoCompany" class="btn btn-primary">
                        <i class="fa fa-plus"></i> Yeni Kargo Firması Ekle
                    </a>
                </div>

                @if (Model != null && Model.Count > 0)
                {
                    <div class="bs-example" data-example-id="bordered-table">
                        <table class="table table-bordered table-striped" id="cargoTable">
                            <thead>
                                <tr>
                                    <th style="width: 70px; text-align: center;">#</th>
                                    <th>Kargo Firması Adı</th>
                                    <th style="width: 100px; text-align: center;">Sil</th>
                                    <th style="width: 100px; text-align: center;">Güncelle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <th scope="row" style="text-align: center; vertical-align: middle;">@count</th>
                                        <td style="font-weight: 600; color: #333; vertical-align: middle;">
                                            @item.Name
                                        </td>
                                        <td style="text-align: center; vertical-align: middle;">
                                            <a href="/Admin/Cargo/DeleteCargoCompany/@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Bu kargo firmasını silmek istediğinize emin misiniz?');">
                                                <i class="fa fa-trash"></i> Sil
                                            </a>
                                        </td>
                                        <td style="text-align: center; vertical-align: middle;">
                                            <a href="/Admin/Cargo/UpdateCargoCompany/@item.Id" class="btn btn-warning btn-sm">
                                                <i class="fa fa-edit"></i> Güncelle
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning" role="alert" style="border-radius: 8px; margin-bottom: 0;">
                        Sistemde henüz kayıtlı bir kargo firması bulunmuyor. Eklemek için sağ üstteki butonu kullanabilirsiniz.
                    </div>
                }

            </div>
        </div>
    </div>
</section>