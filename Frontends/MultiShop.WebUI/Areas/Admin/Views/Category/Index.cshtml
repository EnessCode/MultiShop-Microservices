@model List<ResultCategoryDto>

@{
    ViewData["Title"] = "Kategori Listesi";
    int count = 0;
}

<section class="content container-fluid" style="padding: 0;">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">

                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 10px;">
                    <p style="color: #5e6e82; font-size: 14px; margin: 0;">MultiShop platformunda yer alan kategorilerin güncel listesi.</p>
                    <a href="/Admin/Category/CreateCategory" class="btn btn-primary">
                        <i class="fa fa-plus"></i> Yeni Kategori Ekle
                    </a>
                </div>

                @if (Model != null && Model.Count > 0)
                {
                    <div class="bs-example" data-example-id="bordered-table">
                        <table class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th style="width: 70px; text-align: center;">#</th>
                                    <th style="width: 80px; text-align: center;">Görsel</th>
                                    <th>Kategori Adı</th>
                                    <th style="width: 100px; text-align: center;">Sil</th>
                                    <th style="width: 100px; text-align: center;">Güncelle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <th scope="row" style="text-align: center; vertical-align: middle;">@count</th>

                                        <td style="text-align: center; vertical-align: middle;">
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl" alt="@item.Name" style="width: 50px; height: 50px; object-fit: cover; border-radius: 6px;" />
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">Görsel Yok</span>
                                            }
                                        </td>

                                        <td style="vertical-align: middle;">@item.Name</td>

                                        <td style="text-align: center; vertical-align: middle;">
                                            <a href="/Admin/Category/DeleteCategory/@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Bu kategoriyi silmek istediğinize emin misiniz?');">
                                                <i class="fa fa-trash"></i> Sil
                                            </a>
                                        </td>

                                        <td style="text-align: center; vertical-align: middle;">
                                            <a href="/Admin/Category/UpdateCategory/@item.Id" class="btn btn-warning btn-sm">
                                                <i class="fa fa-edit"></i> Güncelle
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning" role="alert">
                        Sistemde henüz bir kategori bulunmuyor veya veriler yüklenemedi.
                    </div>
                }

            </div>
        </div>
    </div>
</section>