@model List<ResultFeatureDto>

@{
    ViewData["Title"] = "Öne Çıkan Özellikler";
    int count = 0;
}

<section class="content container-fluid" style="padding: 0;">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">

                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; flex-wrap: wrap; gap: 10px;">
                    <p style="color: #5e6e82; font-size: 14px; margin: 0;">Müşterilerinize sunduğunuz hizmet garantilerini (Ücretsiz Kargo, 7/24 Destek vb.) ve mağaza güven rozetlerini buradan yönetebilirsiniz.</p>
                    <a href="/Admin/Feature/CreateFeature" class="btn btn-primary">
                        <i class="fa fa-plus"></i> Yeni Özellik Ekle
                    </a>
                </div>

                <div class="alert alert-info" role="alert" style="border-radius: 6px; border-left: 4px solid #b8daff; background-color: #e8f4fd; color: #0056b3; font-size: 13px; margin-bottom: 20px; padding: 10px 15px;">
                    <i class="fa fa-info-circle" style="font-size: 14px; margin-right: 5px;"></i>
                    <strong>Sistem Notu:</strong> Ana sayfa tasarım bütünlüğünün bozulmaması için bu alana eklediğiniz özelliklerden <strong>yalnızca 4 tanesi</strong> vitrinde gösterilecektir.
                </div>

                @if (Model != null && Model.Count > 0)
                {
                    <div class="bs-example" data-example-id="bordered-table">
                        <table class="table table-bordered table-striped" id="featureTable" data-sort-asc="false">
                            <thead>
                                <tr>
                                    <th style="width: 70px; text-align: center;">#</th>
                                    <th style="width: 120px; text-align: center;">İkon/Görsel</th>
                                    <th>Başlık</th>
                                    <th>Açıklama</th>

                                    <th class="sortable-header" style="width: 120px; text-align: center;" onclick="sortTableByStatus('featureTable')">
                                        Durum <i class="fa fa-sort"></i>
                                    </th>

                                    <th style="width: 100px; text-align: center;">Sil</th>
                                    <th style="width: 100px; text-align: center;">Güncelle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderByDescending(x => x.IsActive))
                                {
                                    count++;
                                    <tr data-status="@(item.IsActive ? 1 : 0)">
                                        <th scope="row" style="text-align: center; vertical-align: middle;">@count</th>

                                        <td style="text-align: center; vertical-align: middle;">
                                            @if (!string.IsNullOrEmpty(item.Icon))
                                            {
                                                if (item.Icon.StartsWith("http") || item.Icon.StartsWith("/"))
                                                {
                                                    <img src="@item.Icon" alt="@item.Title" style="width: 45px; height: 45px; object-fit: contain;" />
                                                }
                                                else
                                                {
                                                    <i class="@item.Icon" style="font-size: 30px; color: #4361ee;"></i>
                                                }
                                            }
                                            else
                                            {
                                                <i class="fa fa-star text-muted" style="font-size: 24px;"></i>
                                            }
                                        </td>

                                        <td style="font-weight: 600; color: #333; vertical-align: middle;">@item.Title</td>

                                        <td style="color: #5e6e82; vertical-align: middle;">@item.Description</td>

                                        <td style="text-align: center; vertical-align: middle;">
                                            @if (item.IsActive)
                                            {
                                                <span class="label" style="background-color: #2ecc71; color: white; padding: 6px 12px; border-radius: 4px; display: inline-block; font-weight: 500;">Aktif</span>
                                            }
                                            else
                                            {
                                                <span class="label" style="background-color: #e74c3c; color: white; padding: 6px 12px; border-radius: 4px; display: inline-block; font-weight: 500;">Pasif</span>
                                            }
                                        </td>

                                        <td style="text-align: center; vertical-align: middle;">
                                            <a href="/Admin/Feature/DeleteFeature/@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Bu özelliği silmek istediğinize emin misiniz?');">
                                                <i class="fa fa-trash"></i> Sil
                                            </a>
                                        </td>

                                        <td style="text-align: center; vertical-align: middle;">
                                            <a href="/Admin/Feature/UpdateFeature/@item.Id" class="btn btn-warning btn-sm">
                                                <i class="fa fa-edit"></i> Güncelle
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning" role="alert" style="border-radius: 8px; margin-bottom: 0;">
                        Sistemde henüz kayıtlı bir öne çıkan özellik bulunmuyor.
                    </div>
                }

            </div>
        </div>
    </div>
</section>