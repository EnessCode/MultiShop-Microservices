@model UpdateProductDto

@{
    ViewData["Title"] = "Ürün Güncelle";
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">

                <div style="margin-bottom: 20px;">
                    <h4 style="font-weight: 600; color: #1e1e2d;">Ürün Güncelle</h4>
                    <p style="color: #5e6e82; font-size: 14px;">Seçili ürünün fiyat, görsel, açıklama ve kategori bilgilerini aşağıdan düzenleyebilirsiniz.</p>
                </div>

                <form method="post" action="/Admin/Product/UpdateProduct">

                    <input type="hidden" asp-for="Id" name="Id" value="@Model?.Id" />

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label style="font-weight: 500; color: #495057; margin-bottom: 8px;">Ürün Adı</label>
                        <input type="text" class="form-control" asp-for="Name" name="Name" value="@Model?.Name" required style="border-radius: 6px; border: 1px solid #edf2f9; padding: 10px 15px; box-shadow: none;" />
                    </div>

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label style="font-weight: 500; color: #495057; margin-bottom: 8px;">Fiyat (₺)</label>
                        <input type="text" class="form-control" asp-for="Price" name="Price" value="@Model?.Price" required style="border-radius: 6px; border: 1px solid #edf2f9; padding: 10px 15px; box-shadow: none;" />
                    </div>

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label style="font-weight: 500; color: #495057; margin-bottom: 8px;">Görsel URL</label>
                        <input type="text" class="form-control" asp-for="ImageUrl" name="ImageUrl" value="@Model?.ImageUrl" style="border-radius: 6px; border: 1px solid #edf2f9; padding: 10px 15px; box-shadow: none;" />
                    </div>

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label style="font-weight: 500; color: #495057; margin-bottom: 8px;">Ürün Açıklaması</label>
                        <textarea class="form-control" asp-for="Description" name="Description" rows="4" style="border-radius: 6px; border: 1px solid #edf2f9; padding: 10px 15px; box-shadow: none;">@Model?.Description</textarea>
                    </div>

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label style="font-weight: 500; color: #495057; margin-bottom: 8px;">Bağlı Olduğu Kategori</label>
                        <select class="form-control" asp-for="CategoryId" asp-items="@ViewBag.CategoryValues" required style="border-radius: 6px; border: 1px solid #edf2f9; padding: 10px 15px; box-shadow: none; height: auto;">
                            <option value="">-- Lütfen Bir Kategori Seçiniz --</option>
                        </select>
                    </div>

                    <div style="margin-top: 30px;">
                        <button type="submit" class="btn btn-warning"><i class="fa fa-edit"></i> Değişiklikleri Kaydet</button>
                        <a href="/Admin/Product/Index" class="btn btn-danger" style="margin-left: 10px;"><i class="fa fa-times"></i> İptal</a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</section>