@model UpdateProductDto

@{
    ViewData["Title"] = "Ürün Güncelle";
}

<section class="content container-fluid" style="padding: 0;">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">

                <div style="margin-bottom: 25px;">
                    <p style="color: #5e6e82; font-size: 14px; margin: 0;">Seçili ürünün fiyat, görsel, açıklama ve kategori bilgilerini aşağıdan düzenleyebilirsiniz.</p>
                </div>

                <form method="post" action="/Admin/Product/UpdateProduct">

                    <input type="hidden" asp-for="Id" name="Id" value="@Model?.Id" />

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label style="font-weight: 500; color: #495057; margin-bottom: 8px;">Ürün Adı</label>
                        <input type="text" class="form-control" asp-for="Name" name="Name" value="@Model?.Name" required style="border-radius: 6px; border: 1px solid #edf2f9; padding: 10px 15px; box-shadow: none;" />
                    </div>

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label style="font-weight: 500; color: #495057; margin-bottom: 8px;">Satış Fiyatı (₺)</label>
                        <input type="text" class="form-control" asp-for="Price" name="Price" value="@Model?.Price" required style="border-radius: 6px; border: 1px solid #edf2f9; padding: 10px 15px; box-shadow: none;" />
                    </div>

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label style="font-weight: 500; color: #495057; margin-bottom: 8px;">Eski Fiyat (₺) - <small class="text-muted">İndirim yoksa boş bırakın</small></label>
                        <input type="text" class="form-control" asp-for="OldPrice" name="OldPrice" value="@Model?.OldPrice" style="border-radius: 6px; border: 1px solid #edf2f9; padding: 10px 15px; box-shadow: none;" />
                    </div>

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label style="font-weight: 500; color: #495057; margin-bottom: 8px;">Görsel URL</label>
                        <input type="text" class="form-control" asp-for="ImageUrl" name="ImageUrl" id="ImageUrl" oninput="updatePreview()" value="@Model?.ImageUrl" style="border-radius: 6px; border: 1px solid #edf2f9; padding: 10px 15px; box-shadow: none;" />

                        <div style="margin-top: 15px;">
                            <p style="font-size: 13px; color: #6c757d; margin-bottom: 5px;"><i class="fa fa-image"></i> Görsel Ön İzleme</p>
                            <img id="imagePreview" src="" alt="Önizleme" style="max-width: 100%; height: 200px; object-fit: cover; border-radius: 6px; border: 1px dashed #ced4da; display: none; padding: 4px;" />
                        </div>
                    </div>

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label style="font-weight: 500; color: #495057; margin-bottom: 8px;">Ürün Açıklaması</label>
                        <textarea class="form-control" asp-for="Description" name="Description" rows="4" style="border-radius: 6px; border: 1px solid #edf2f9; padding: 10px 15px; box-shadow: none;">@Model?.Description</textarea>
                    </div>

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label style="font-weight: 500; color: #495057; margin-bottom: 8px;">Bağlı Olduğu Kategori</label>
                        <select class="form-control" asp-for="CategoryId" asp-items="@ViewBag.CategoryValues" required style="border-radius: 6px; border: 1px solid #edf2f9; padding: 10px 15px; box-shadow: none; height: auto;">
                            <option value="">-- Lütfen Bir Kategori Seçiniz --</option>
                        </select>
                    </div>

                    <div style="margin-top: 30px;">
                        <button type="submit" class="btn btn-warning"><i class="fa fa-edit"></i> Değişiklikleri Kaydet</button>
                        <a href="/Admin/Product/ProductListWithCategory" class="btn btn-danger" style="margin-left: 10px;"><i class="fa fa-times"></i> İptal</a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</section>

<script>
    function updatePreview() {
        var url = document.getElementById('ImageUrl').value;
        var preview = document.getElementById('imagePreview');
        if (url) {
            preview.src = url;
            preview.style.display = 'block';
        } else {
            preview.src = '';
            preview.style.display = 'none';
        }
    }

    window.onload = function() {
        updatePreview();
    };
</script>