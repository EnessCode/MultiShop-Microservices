@model CreateProductDto

@{
    ViewData["Title"] = "Yeni Ürün Ekle";
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">

                <div style="margin-bottom: 20px;">
                    <h4 style="font-weight: 600; color: #1e1e2d;">Yeni Ürün Ekle</h4>
                    <p style="color: #5e6e82; font-size: 14px;">MultiShop sistemine yeni bir ürün tanımlamak için aşağıdaki formu eksiksiz doldurunuz.</p>
                </div>

                <form method="post" action="/Admin/Product/CreateProduct">

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label style="font-weight: 500; color: #495057; margin-bottom: 8px;">Ürün Adı</label>
                        <input type="text" class="form-control" asp-for="Name" name="Name" required placeholder="Örn: Laptop, Akıllı Telefon..." style="border-radius: 6px; border: 1px solid #edf2f9; padding: 10px 15px; box-shadow: none;" />
                    </div>

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label style="font-weight: 500; color: #495057; margin-bottom: 8px;">Fiyat (₺)</label>
                        <input type="text" class="form-control" asp-for="Price" name="Price" required placeholder="Örn: 15000.50" style="border-radius: 6px; border: 1px solid #edf2f9; padding: 10px 15px; box-shadow: none;" />
                    </div>

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label style="font-weight: 500; color: #495057; margin-bottom: 8px;">Görsel URL</label>
                        <input type="text" class="form-control" asp-for="ImageUrl" name="ImageUrl" placeholder="Örn: https://.../gorsel.jpg" style="border-radius: 6px; border: 1px solid #edf2f9; padding: 10px 15px; box-shadow: none;" />
                    </div>

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label style="font-weight: 500; color: #495057; margin-bottom: 8px;">Ürün Açıklaması</label>
                        <textarea class="form-control" asp-for="Description" name="Description" rows="4" placeholder="Ürün hakkında detaylı bilgi giriniz..." style="border-radius: 6px; border: 1px solid #edf2f9; padding: 10px 15px; box-shadow: none;"></textarea>
                    </div>

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label style="font-weight: 500; color: #495057; margin-bottom: 8px;">Bağlı Olduğu Kategori</label>
                        <select class="form-control" asp-for="CategoryId" asp-items="@ViewBag.CategoryValues" required style="border-radius: 6px; border: 1px solid #edf2f9; padding: 10px 15px; box-shadow: none; height: auto;">
                            <option value="">-- Lütfen Bir Kategori Seçiniz --</option>
                        </select>
                    </div>

                    <div style="margin-top: 30px;">
                        <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Ürünü Kaydet</button>
                        <a href="/Admin/Product/Index" class="btn btn-danger" style="margin-left: 10px;"><i class="fa fa-times"></i> İptal</a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</section>