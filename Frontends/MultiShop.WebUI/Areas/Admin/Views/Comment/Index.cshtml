@model List<ResultCommentDto>

@{
    ViewData["Title"] = "Yorum Listesi";
    int count = 0;
}

<section class="content container-fluid" style="padding: 0;">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                    <p style="color: #5e6e82; font-size: 14px; margin: 0;">
                        MultiShop platformundaki kullanıcı yorumlarının güncel listesi.
                    </p>
                </div>

                @if (Model != null && Model.Count > 0)
                {
                    <div class="bs-example" data-example-id="bordered-table">
                        <table class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th style="width: 70px; text-align: center;">#</th>
                                    <th>Kullanıcı</th>
                                    <th>Ürün ID</th>
                                    <th>Puan</th>
                                    <th>Durum</th>
                                    <th style="width: 100px; text-align: center;">Sil</th>
                                    <th style="width: 100px; text-align: center;">Güncelle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <td style="text-align: center; vertical-align: middle;">@count</td>
                                        <td style="vertical-align: middle;">
                                            <div style="font-weight: 600; color: #333;">@item.NameSurname</div>
                                            <small style="color: #6c757d;">@item.Email</small>
                                        </td>
                                        <td style="vertical-align: middle;">@item.ProductId</td>
                                        <td style="vertical-align: middle;">@item.Rating / 5</td>
                                        <td style="vertical-align: middle;">
                                            <span class="badge @(item.Status ? "badge-success" : "badge-secondary")">
                                                @(item.Status ? "Aktif" : "Pasif")
                                            </span>
                                        </td>
                                        <td style="text-align: center; vertical-align: middle;">
                                            <a href="/Admin/Comment/DeleteComment/@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Bu yorumu silmek istediğinize emin misiniz?');">
                                                <i class="fa fa-trash"></i> Sil
                                            </a>
                                        </td>
                                        <td style="text-align: center; vertical-align: middle;">
                                            <a href="/Admin/Comment/UpdateComment/@item.Id" class="btn btn-warning btn-sm">
                                                <i class="fa fa-edit"></i> Güncelle
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning" role="alert" style="border-radius: 8px; margin-bottom: 0;">
                        Sistemde henüz bir yorum bulunmuyor.
                    </div>
                }
            </div>
        </div>
    </div>
</section>