@model List<ResultInboxUserMessageDto>

<div class="col-lg-12 grid-margin stretch-card mt-3">
    <div class="card order-card border-0 bg-white">
        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="card-title fw-bold text-dark mb-1">Gelen Kutusu</h4>
                    <p class="text-muted small mb-0">
                        Size gelen mesajları ve bildirimleri buradan takip edebilir, detaylarını okuyabilirsiniz.
                    </p>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table modern-table table-borderless w-100 mb-0">
                    <thead>
                        <tr>
                            <th style="width: 25%;">Gönderen</th>
                            <th style="width: 35%;">Konu</th>
                            <th style="width: 20%;">Tarih</th>
                            <th class="text-end" style="width: 20%;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        @if (!item.IsRead)
                                        {
                                            <span class="badge-soft-primary me-2">Yeni</span>
                                        }
                                        <span class="fw-bold text-dark">@item.SenderId</span>
                                    </div>
                                </td>
                                <td class="text-dark" style="font-size: 1.05rem;">
                                    @item.Subject
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <i class="mdi mdi-calendar-clock text-muted me-2" style="font-size: 1.2rem;"></i>
                                        <span>@item.MessageDate.ToString("dd MMM yyyy, HH:mm")</span>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <a href="/User/Message/MessageDetail/@item.Id" class="btn btn-outline-primary btn-sm btn-modern">
                                        Mesajı Oku <i class="mdi mdi-chevron-right ms-1"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>