@model List<ResultCategoryDto>

<div class="container-fluid bg-dark mb-4 sticky-top shadow-sm">
	<div class="row px-xl-5 align-items-center">
		<div class="col-lg-3 d-none d-lg-block">
			<a class="btn d-flex align-items-center justify-content-between bg-primary w-100 rounded-top-4" data-bs-toggle="collapse" href="#navbar-vertical" style="height: 60px; padding: 0 25px; transition: all 0.3s ease;">
				<h6 class="text-dark m-0 fw-semibold"><i class="fas fa-bars me-3"></i>Kategoriler</h6>
				<i class="fas fa-angle-down text-dark transition-icon"></i>
			</a>
			<nav class="collapse position-absolute navbar navbar-vertical navbar-light align-items-start p-0 bg-white shadow-lg rounded-bottom-4 overflow-hidden" id="navbar-vertical" style="width: calc(100% - 30px); z-index: 999;">
				<div class="navbar-nav w-100 border-0">
					@foreach(var item in Model)
					{
						<a href="/ProductList/Index/@item.Id" class="nav-item nav-link py-2 px-4"><i class="fas fa-tag me-2 text-muted" style="width: 20px;"></i>@item.Name</a>
					}
				</div>
			</nav>
		</div>

		<div class="col-lg-9">
			<nav class="navbar navbar-expand-lg bg-dark navbar-dark py-3 py-lg-0 px-0">
				<a href="/" class="text-decoration-none d-block d-lg-none">
					<span class="h3 fw-bold text-uppercase text-white">Multi<span class="text-primary">Shop</span></span>
				</a>

				<div class="d-flex d-lg-none ms-auto me-3 gap-2">
					<a href="/Wishlist" class="btn position-relative text-white p-2">
						<i class="fas fa-heart text-primary"></i>
						<span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">0</span>
					</a>
					<a href="/Cart" class="btn position-relative text-white p-2">
						<i class="fas fa-shopping-cart text-primary"></i>
						<span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">0</span>
					</a>
				</div>

				<button type="button" class="navbar-toggler border-0 shadow-none" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
					<span class="navbar-toggler-icon"></span>
				</button>

				<div class="collapse navbar-collapse justify-content-between" id="navbarCollapse">
					<div class="navbar-nav me-auto py-3 py-lg-0 gap-1">
						<a href="/Home/Index" class="nav-item nav-link py-3">Anasayfa</a>
						<a href="/Shop" class="nav-item nav-link py-3">Mağaza</a>
						<a href="/ProductDetail" class="nav-item nav-link py-3">Ürün Detayı</a>
						<div class="nav-item dropdown">
							<a href="#" class="nav-link dropdown-toggle py-3 d-flex align-items-center" data-bs-toggle="dropdown">
								Sayfalar <i class="fas fa-angle-down ms-1" style="font-size: 0.8rem; width: 12px;"></i>
							</a>
							<div class="dropdown-menu border-0 shadow bg-white rounded-3 m-0 py-2">
								<a href="/Cart" class="dropdown-item py-2 px-4 text-dark">Sepetim</a>
								<a href="/Checkout" class="dropdown-item py-2 px-4 text-dark">Ödeme Sayfası</a>
							</div>
						</div>
						<a href="/Contact/Index" class="nav-item nav-link py-3">İletişim</a>
					</div>

					<div class="navbar-nav ms-auto py-0 d-none d-lg-flex gap-3">
						<a href="/Wishlist" class="btn position-relative px-2 text-white transition-all">
							<i class="fas fa-heart text-primary fs-5"></i>
							<span class="position-absolute top-0 start-100 translate-middle badge rounded-circle bg-danger border border-dark p-1" style="font-size: 0.7rem; min-width: 18px; height: 18px;">0</span>
						</a>
						<a href="/Cart" class="btn position-relative px-2 text-white transition-all">
							<i class="fas fa-shopping-cart text-primary fs-5"></i>
							<span class="position-absolute top-0 start-100 translate-middle badge rounded-circle bg-danger border border-dark p-1" style="font-size: 0.7rem; min-width: 18px; height: 18px;">0</span>
						</a>
					</div>
				</div>
			</nav>
		</div>
	</div>
</div>

<style>
	.sticky-top {
		top: 0;
		z-index: 1020;
	}

	.navbar-dark .navbar-nav .nav-link {
		color: rgba(255, 255, 255, 0.75);
		font-weight: 500;
		font-size: 0.95rem;
		transition: color 0.2s ease-in-out;
	}

		.navbar-dark .navbar-nav .nav-link:hover,
		.navbar-dark .navbar-nav .nav-link.active {
			color: var(--bs-primary) !important;
		}

	.dropdown-item:hover {
		background-color: rgba(0, 0, 0, 0.03);
	}

	.transition-all {
		transition: all 0.2s ease;
	}

		.transition-all:hover {
			transform: translateY(-2px);
		}
</style>