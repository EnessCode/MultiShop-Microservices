@model ResultAddressDto

<div class="col-lg-5 mb-5">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4" style="height: 250px;">
        <iframe class="w-100 h-100 border-0"
                src="@Model.MapUrl"
                allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <div class="d-flex flex-column gap-3.5">
            <div class="d-flex align-items-center py-2">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; min-width: 40px;">
                    <i class="fas fa-map-marker-alt"></i>
                </div>
                <div>
                    <p class="m-0 text-muted small" style="font-size: 0.75rem;">Adres</p>
                    <span class="fw-semibold text-dark" style="font-size: 0.95rem;">@Model.AddressDetail</span>
                </div>
            </div>

            <div class="d-flex align-items-center py-2 border-top border-light">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; min-width: 40px;">
                    <i class="fas fa-envelope"></i>
                </div>
                <div>
                    <p class="m-0 text-muted small" style="font-size: 0.75rem;">E-posta</p>
                    <a href="mailto:@Model.Email" class="fw-semibold text-dark text-decoration-none hover-primary" style="font-size: 0.95rem;">@Model.Email</a>
                </div>
            </div>

            <div class="d-flex align-items-center py-2 border-top border-light">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; min-width: 40px;">
                    <i class="fas fa-phone-alt"></i>
                </div>
                <div>
                    <p class="m-0 text-muted small" style="font-size: 0.75rem;">Telefon</p>
                    <a href="tel:@Model.Phone" class="fw-semibold text-dark text-decoration-none hover-primary" style="font-size: 0.95rem;">@Model.Phone</a>
                </div>
            </div>
        </div>
    </div>
</div>