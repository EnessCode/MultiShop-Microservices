@model List<BasketItemDto>

<div class="col-lg-8 mb-5">
	<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
		<div class="table-responsive">
			<table class="table table-hover text-center align-middle mb-0">
				<thead class="table-light text-secondary fw-semibold border-bottom" style="font-size: 0.9rem;">
					<tr>
						<th class="py-3 text-start ps-4">Ürünler</th>
						<th class="py-3">Fiyat</th>
						<th class="py-3">Adet</th>
						<th class="py-3">Toplam</th>
						<th class="py-3 pe-4">Sil</th>
					</tr>
				</thead>
				<tbody class="align-middle">
					@foreach (var item in Model)
					{
						<tr class="border-bottom">
							<td class="text-start ps-4 py-3 align-middle">
								<div class="d-flex align-items-center gap-3">
									<img src="@item.ProductImageUrl" alt="Ürün" class="rounded-3 border" style="width: 55px; height: 55px; object-fit: cover;">
									<span class="fw-semibold text-dark" style="font-size: 0.95rem;">@item.ProductName</span>
								</div>
							</td>
							<td class="fw-medium align-middle" style="font-size: 0.95rem;">@item.Price.ToString("N2") TL</td>
							<td class="align-middle">
								<div class="input-group quantity mx-auto border rounded-pill overflow-hidden bg-light" style="width: 110px; height: 35px;">
									<button class="btn btn-sm btn-link text-secondary border-0 px-2 shadow-none btn-minus" type="button">
										<i class="fa fa-minus" style="font-size: 0.8rem;"></i>
									</button>
									<input type="text" class="form-control form-control-sm bg-transparent border-0 text-center fw-semibold text-dark shadow-none p-0" value="@item.Quantity" readonly>
									<button class="btn btn-sm btn-link text-secondary border-0 px-2 shadow-none btn-plus" type="button">
										<i class="fa fa-plus" style="font-size: 0.8rem;"></i>
									</button>
								</div>
							</td>
							<td class="fw-bold text-dark align-middle" style="font-size: 0.95rem;">@((item.Price * item.Quantity).ToString("N2")) TL</td>
							<td class="pe-4 align-middle">
								<a href="/Basket/RemoveBasketItem/@item.ProductId" class="btn btn-sm btn-outline-danger rounded-circle d-inline-flex align-items-center justify-content-center p-0 mx-auto" style="width: 32px; height: 32px;" title="Ürünü Sil">
									<i class="fa fa-times" style="font-size: 0.85rem;"></i>
								</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>
