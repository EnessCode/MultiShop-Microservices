@model List<ResultBrandDto>

<div class="container-fluid py-4 mb-5">
    <div class="row px-xl-5">
        <div class="col">
            <div class="bg-white border rounded-4 p-4 shadow-sm">
                <div class="owl-carousel vendor-carousel d-flex align-items-center">
                    @foreach (var item in Model.Where(x => x.IsActive))
                    {
                    <div class="vendor-logo-box px-3">
                        <img src="@item.ImageUrl" alt="@item.Name" class="img-fluid opacity-75 hover-opacity-100" style="max-height: 45px; object-fit: contain;">
                    </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .vendor-logo-box {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 60px;
    }

    .hover-opacity-100 {
        transition: opacity 0.3s ease, transform 0.3s ease;
    }

        .hover-opacity-100:hover {
            opacity: 1 !important;
            transform: scale(1.05);
        }
</style>