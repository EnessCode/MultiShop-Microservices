@model ResultProductImageDto

<div class="col-lg-5 mb-30">
    <div id="product-carousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner bg-light">
            
            @if (Model != null && Model.Images != null && Model.Images.Any())
            {
                int count = 0;
                foreach (var imageUrl in Model.Images)
                {
                    <div class="carousel-item @(count == 0 ? "active" : "")">
                        <img class="w-100" src="@imageUrl" alt="Ürün Görseli" style="height: 500px; object-fit: contain;">
                    </div>
                    count++;
                }
            }
            else
            {
                <div class="carousel-item active">
                    <img class="w-100 h-100" src="/online-shop-website-template/images/placeholder.jpg" alt="Görsel Yok" style="object-fit: contain;">
                </div>
            }

        </div>
        
        @if (Model != null && Model.Images != null && Model.Images.Count > 1)
        {
            <a class="carousel-control-prev" href="#product-carousel" data-bs-slide="prev">
                <i class="fa fa-2x fa-angle-left text-dark"></i>
            </a>
            <a class="carousel-control-next" href="#product-carousel" data-bs-slide="next">
                <i class="fa fa-2x fa-angle-right text-dark"></i>
            </a>
        }
    </div>
</div>