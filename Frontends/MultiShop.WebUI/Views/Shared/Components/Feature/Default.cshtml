@model List<ResultFeatureDto>

<div class="container-fluid pt-4">
	<div class="row px-xl-5 pb-3">
		@foreach (var item in Model.Where(x => x.IsActive).OrderByDescending(x => x.Id).Take(4))
		{
			<div class="col-lg-3 col-md-6 col-sm-12 mb-4">
				<div class="d-flex align-items-center bg-white border rounded-4 p-4 shadow-sm hover-card">
					<div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center me-4 shadow-sm" style="width: 60px; height: 60px; min-width: 60px;">
						<i class="@item.Icon"></i>
					</div>
					<div>
						<h6 class="fw-bold m-0 mb-1" style="font-size: 1rem;">@item.Title</h6>
						<small class="text-muted">@item.Description</small>
					</div>
				</div>
			</div>
		}
	</div>
</div>

<style>
	.hover-card {
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}

		.hover-card:hover {
			transform: translateY(-5px);
			box-shadow: 0 12px 20px rgba(0,0,0,0.08) !important;
			border-color: var(--bs-primary) !important;
		}

	.bg-primary-subtle {
		background-color: rgba(255, 211, 0, 0.15) !important;
	}
</style>