@model List<ResultProductDto>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.min.css" />

<div class="container-fluid pt-5 pb-3">
	<div class="d-flex justify-content-between align-items-center mx-xl-5 mb-4 border-bottom pb-2">
		<h4 class="fw-bold m-0 text-uppercase tracking-wide" style="font-size: 1.25rem;">Öne Çıkan Ürünler</h4>
		<span class="badge bg-primary text-dark rounded-pill px-3 py-2 fw-semibold">Haftanın Fırsatları</span>
	</div>

	<div class="row px-xl-5">
		<div class="col">
			<div class="owl-carousel product-carousel">
				@foreach (var item in Model)
				{
					<div class="card h-100 border rounded-4 overflow-hidden shadow-sm product-modern-card bg-white mx-2 my-3">

						<div class="position-relative overflow-hidden bg-light card-img-container" style="height: 280px;">
							<img class="w-100 h-100 product-img" src="@item.ImageUrl" alt="@item.Name" style="object-fit: cover;">

							@if (item.DiscountPercentage > 0)
							{
								<span class="position-absolute top-0 start-0 m-3 badge bg-danger rounded-pill px-3 py-2 fw-bold shadow-sm" style="z-index: 5;">
									%@item.DiscountPercentage İNDİRİM
								</span>
							}

							<div class="product-action-overlay position-absolute top-0 bottom-0 start-0 end-0 d-flex align-items-center justify-content-center gap-2 bg-dark bg-opacity-25 opacity-0 transition-all">
								<a class="btn btn-white text-dark rounded-circle shadow-sm p-0 d-flex align-items-center justify-content-center action-btn" href="/Cart/AddToCart/@item.Id" title="Sepete Ekle">
									<i class="fa fa-shopping-cart"></i>
								</a>
								<a class="btn btn-white text-dark rounded-circle shadow-sm p-0 d-flex align-items-center justify-content-center action-btn" href="/Wishlist/Add/@item.Id" title="Favorilere Ekle">
									<i class="far fa-heart"></i>
								</a>
								<a class="btn btn-white text-dark rounded-circle shadow-sm p-0 d-flex align-items-center justify-content-center action-btn" href="/ProductList/ProductDetail/@item.Id" title="Ürünü İncele">
									<i class="fa fa-search"></i>
								</a>
							</div>
						</div>

						<div class="card-body text-center p-4 d-flex flex-column justify-content-between">
							<div>
								<a class="h6 text-decoration-none text-dark fw-semibold text-truncate d-block mb-2 card-product-title" href="/ProductList/ProductDetail/@item.Id">@item.Name</a>

								<div class="d-flex align-items-center justify-content-center gap-1 mb-2">
									<div class="text-warning small">
										@{
											double avgRating = (ViewBag.Ratings as Dictionary<string, double>)[item.Id];
											int fullStars = (int)Math.Floor(avgRating);
											bool hasHalfStar = (avgRating - fullStars) >= 0.5;
											int emptyStars = 5 - fullStars - (hasHalfStar ? 1 : 0);
										}

										@for (int i = 0; i < fullStars; i++)
										{
											<i class="fa fa-star"></i>
										}
										@if (hasHalfStar)
										{
											<i class="fa fa-star-half-alt"></i>
										}
										@for (int i = 0; i < emptyStars; i++)
										{
											<i class="far fa-star"></i>
										}
									</div>
								</div>
							</div>

							<div class="d-flex align-items-center justify-content-center gap-2 mt-2">
								<h5 class="text-primary fw-bold m-0" style="font-size: 1.2rem;">@item.Price.ToString("N2") TL</h5>

								@if (item.OldPrice.HasValue && item.OldPrice > item.Price)
								{
									<h6 class="text-muted text-decoration-line-through m-0 small">@item.OldPrice.Value.ToString("N2") TL</h6>
								}
							</div>
						</div>
					</div>
				}
			</div>
		</div>
	</div>
</div>

<style>
	.product-modern-card {
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}

		.product-modern-card:hover {
			transform: translateY(-6px);
			box-shadow: 0 15px 30px rgba(0,0,0,0.08) !important;
		}

	.card-img-container .product-img {
		transition: transform 0.5s ease;
	}

	.product-modern-card:hover .product-img {
		transform: scale(1.05);
	}

	.product-modern-card:hover .product-action-overlay {
		opacity: 1 !important;
	}

	.btn-white {
		background-color: #fff !important;
		border: none;
	}

	.action-btn {
		width: 42px;
		height: 42px;
		transition: all 0.2s ease;
	}

		.action-btn:hover {
			background-color: var(--bs-primary) !important;
			color: #000 !important;
			transform: scale(1.1);
		}

	.card-product-title {
		transition: color 0.2s ease;
	}

		.card-product-title:hover {
			color: var(--bs-primary) !important;
		}

	.owl-theme .owl-dots .owl-dot.active span,
	.owl-theme .owl-dots .owl-dot:hover span {
		background: var(--bs-primary) !important;
	}
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js"></script>

<script>
	$(document).ready(function () {
		$('.product-carousel').owlCarousel({
			loop: true,               
			margin: 15,               
			nav: false,               
			dots: true,               
			autoplay: true,           
			autoplayTimeout: 3000,   
			autoplayHoverPause: true, 
			responsive: {            
				0: {
					items: 1
				},
				576: {
					items: 2
				},
				768: {
					items: 3
				},
				992: {
					items: 4
				}
			}
		});
	});
</script>