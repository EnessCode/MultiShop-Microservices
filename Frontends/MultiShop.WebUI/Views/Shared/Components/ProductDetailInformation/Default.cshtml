@model ResultProductDetailDto

<div class="tab-pane fade" id="tab-pane-2">
    <h4 class="mb-3">Ek Bilgiler</h4>

    @if (Model != null && !string.IsNullOrEmpty(Model.Information))
    {
        <p>@Html.Raw(Model.Information)</p>
    }
    else
    {
        <p class="text-muted">Bu ürün için ek bilgi bulunmamaktadır.</p>
    }
</div>