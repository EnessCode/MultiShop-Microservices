@model BasketTotalDto
@{
	decimal subTotal = Model != null ? Model.TotalPrice : 0;

	decimal discountRate = (Model != null && !string.IsNullOrEmpty(Model.DiscountCode)) ? Model.DiscountRate : 0;

	decimal discountAmount = subTotal * discountRate / 100;
	decimal totalAfterDiscount = subTotal - discountAmount;

	decimal freeShippingLimit = 500;
	decimal shippingFee = 49.90m;

	decimal shipping = (totalAfterDiscount > 0 && totalAfterDiscount < freeShippingLimit) ? shippingFee : 0;
	decimal grandTotal = totalAfterDiscount + shipping;

	decimal amountLeft = freeShippingLimit - totalAfterDiscount;
}

<div class="col-lg-4">
	@await Component.InvokeAsync("DiscountCoupon")

	<div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-5">
		<div class="card-header bg-white border-bottom-0 pt-4 px-4 pb-2">
			<h6 class="fw-bold m-0 text-uppercase tracking-wide border-start border-primary border-3 ps-3" style="font-size: 0.95rem;">
				Sepet Özeti
			</h6>
		</div>
		<div class="card-body p-4">

			<div id="summary-alert-container">
				@if (totalAfterDiscount > 0 && totalAfterDiscount < freeShippingLimit)
				{
					<div class="alert alert-warning py-2 px-3 text-center rounded-3 mb-4" style="font-size: 0.85rem;">
						Ücretsiz kargo için <strong class="text-danger">@amountLeft.ToString("N2") TL</strong> daha alışveriş yapın!
					</div>
				}
				else if (totalAfterDiscount >= freeShippingLimit)
				{
					<div class="alert alert-success py-2 px-3 text-center rounded-3 mb-4" style="font-size: 0.85rem;">
						<i class="fa fa-truck me-1"></i> Kargonuz <strong>Bedava!</strong>
					</div>
				}
			</div> 

			<div class="d-flex justify-content-between mb-3 border-bottom pb-2">
				<span class="text-secondary fw-medium">Ara Toplam</span>
				<span class="fw-semibold text-dark" id="summary-subtotal">@subTotal.ToString("N2") TL</span>
			</div>

			@if (discountAmount > 0)
			{
				<div class="d-flex justify-content-between mb-3 border-bottom pb-2 align-items-center">
					<span class="text-secondary fw-medium">
						İndirim (%@discountRate)
						<br>
						<a href="/Discount/CancelCoupon" class="text-danger text-decoration-none mt-1 d-inline-block" style="font-size: 0.75rem;">
							<i class="fa fa-times-circle me-1"></i>Kuponu İptal Et
						</a>
					</span>
					<span class="fw-bold text-success" id="summary-discount">- @discountAmount.ToString("N2") TL</span>
				</div>
			}

			<div class="d-flex justify-content-between mb-3 border-bottom pb-2">
				<span class="text-secondary fw-medium">Kargo</span>
				<span class="fw-semibold @(shipping == 0 ? "text-success" : "text-danger")" id="summary-shipping">
					@(shipping == 0 && totalAfterDiscount > 0 ? "Bedava" : "+ " + shipping.ToString("N2") + " TL")
				</span>
			</div>

			<div class="d-flex justify-content-between align-items-center mt-3 pt-2 mb-4">
				<h5 class="fw-bold m-0" style="font-size: 1.15rem;">Genel Toplam</h5>
				<h4 class="text-primary fw-bold m-0" id="summary-grandtotal" style="font-size: 1.4rem;">@grandTotal.ToString("N2") TL</h4>
			</div>

			<button class="btn btn-primary w-100 rounded-pill py-3 fw-bold shadow-sm transition-up">
				Ödeme Adımına Geç <i class="fa fa-arrow-right ms-2" style="font-size: 0.85rem;"></i>
			</button>
		</div>
	</div>
</div>