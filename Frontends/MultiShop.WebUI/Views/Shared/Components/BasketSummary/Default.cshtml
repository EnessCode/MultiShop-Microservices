@model MultiShop.DtoLayer.Dtos.BasketDtos.BasketTotalDto
@{
	decimal subTotal = Model != null ? Model.TotalPrice : 0;
	decimal shipping = subTotal > 0 ? 10 : 0;
	decimal grandTotal = subTotal + shipping;
}

<div class="col-lg-4">
	<form class="mb-4" action="">
		<div class="input-group border rounded-pill overflow-hidden p-1 bg-white shadow-sm">
			<input type="text" class="form-control bg-transparent border-0 ps-3 shadow-none" placeholder="Kupon Kodu" style="font-size: 0.9rem;">
			<button class="btn btn-primary rounded-pill px-4 fw-semibold" type="submit" style="font-size: 0.85rem;">Kuponu Uygula</button>
		</div>
	</form>

	<div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-5">
		<div class="card-header bg-white border-bottom-0 pt-4 px-4 pb-2">
			<h6 class="fw-bold m-0 text-uppercase tracking-wide border-start border-primary border-3 ps-3" style="font-size: 0.95rem;">
				Sepet Özeti
			</h6>
		</div>
		<div class="card-body p-4">
			<div class="d-flex justify-content-between mb-3 border-bottom pb-2">
				<span class="text-secondary fw-medium">Ara Toplam</span>
				<span class="fw-semibold text-dark">@subTotal.ToString("N2") TL</span>
			</div>
			<div class="d-flex justify-content-between mb-3 border-bottom pb-2">
				<span class="text-secondary fw-medium">Kargo</span>
				<span class="fw-semibold text-success">@shipping.ToString("N2") TL</span>
			</div>
			<div class="d-flex justify-content-between align-items-center mt-3 pt-2 mb-4">
				<h5 class="fw-bold m-0" style="font-size: 1.15rem;">Genel Toplam</h5>
				<h4 class="text-primary fw-bold m-0" style="font-size: 1.4rem;">@grandTotal.ToString("N2") TL</h4>
			</div>
			<button class="btn btn-primary w-100 rounded-pill py-3 fw-bold shadow-sm transition-up">
				Ödeme Adımına Geç <i class="fa fa-arrow-right ms-2" style="font-size: 0.85rem;"></i>
			</button>
		</div>
	</div>
</div>