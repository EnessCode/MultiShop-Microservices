@model CreateContactDto

<div class="col-lg-7 mb-5">
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <div class="card-header bg-white border-bottom-0 pt-2 px-0 pb-3">
            <h5 class="fw-bold m-0 text-uppercase tracking-wide border-start border-primary border-3 ps-3" style="font-size: 1.1rem;">
                Bizimle İletişime Geçin
            </h5>
        </div>
        <div class="card-body p-0">
            <form asp-controller="Contact" asp-action="Index" method="post">
                <div class="mb-3">
                    <label for="name" class="form-label small fw-semibold text-secondary">Adınız Soyadınız</label>
                    <input type="text" name="NameSurname" class="form-control rounded-3 py-2 shadow-none" id="name" placeholder="Lütfen adınızı giriniz" required />
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label small fw-semibold text-secondary">E-posta Adresiniz</label>
                    <input type="email" name="Email" class="form-control rounded-3 py-2 shadow-none" id="email" placeholder="Örn: ad@ornek.com" required />
                </div>
                <div class="mb-3">
                    <label for="subject" class="form-label small fw-semibold text-secondary">Konu</label>
                    <input type="text" name="Subject" class="form-control rounded-3 py-2 shadow-none" id="subject" placeholder="Mesajınızın konusu nedir?" required />
                </div>
                <div class="mb-4">
                    <label for="message" class="form-label small fw-semibold text-secondary">Mesajınız</label>
                    <textarea name="Message" class="form-control rounded-3 py-2 shadow-none" rows="3" id="message" placeholder="Bizimle paylaşmak istediğiniz mesajınız..." required></textarea>
                </div>

                <div>
                    <button class="btn btn-primary rounded-pill py-2.5 px-4 fw-bold shadow-sm transition-up" type="submit">
                        Mesaj Gönder <i class="fas fa-paper-plane ms-2" style="font-size: 0.85rem;"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>