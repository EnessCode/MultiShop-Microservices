<div class="card border-0 shadow-sm rounded-4 bg-white mb-5">
	<div class="card-header bg-white border-bottom-0 pt-4 px-4 pb-2">
		<h5 class="fw-bold m-0 text-uppercase tracking-wide border-start border-primary border-3 ps-3" style="font-size: 1.1rem;">
			Ödeme Yöntemi
		</h5>
	</div>
	<div class="card-body p-4">
		<div class="form-check mb-3">
			<input type="radio" class="form-check-input shadow-none cursor-pointer" name="payment" id="creditcard" checked>
			<label class="form-check-label fw-medium text-dark cursor-pointer" for="creditcard">
				Kredi / Banka Kartı
			</label>
		</div>
		<div class="form-check mb-3">
			<input type="radio" class="form-check-input shadow-none cursor-pointer" name="payment" id="banktransfer">
			<label class="form-check-label fw-medium text-dark cursor-pointer" for="banktransfer">
				Havale / EFT
			</label>
		</div>
		<div class="form-check mb-4">
			<input type="radio" class="form-check-input shadow-none cursor-pointer" name="payment" id="cashondelivery">
			<label class="form-check-label fw-medium text-dark cursor-pointer" for="cashondelivery">
				Kapıda Ödeme
			</label>
		</div>
		<button class="btn btn-primary w-100 rounded-pill py-3 fw-bold shadow-sm transition-up">
			Siparişi Tamamla <i class="fas fa-check ms-1"></i>
		</button>
	</div>
</div>
