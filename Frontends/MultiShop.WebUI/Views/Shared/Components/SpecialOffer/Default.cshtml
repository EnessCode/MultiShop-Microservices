@model List<ResultSpecialOfferDto>

<div class="col-lg-4">
    <div class="d-flex flex-column h-100 gap-3 justify-content-between">

        @foreach (var item in Model.Where(x => x.IsActive).OrderByDescending(x => x.Id).Take(2))
        {
            <div class="product-offer position-relative rounded-4 overflow-hidden shadow-sm w-100 flex-fill" style="height: 204px; background-image: url('@item.ImageUrl'); background-size: cover; background-position: center; transition: all 0.4s ease;">
                <div class="position-absolute top-0 bottom-0 start-0 end-0 d-flex flex-column align-items-start justify-content-center p-4 bg-dark bg-opacity-50 text-white">
                    <span class="badge bg-danger rounded-pill px-3 py-2 mb-2 fw-semibold" style="font-size: 0.75rem;">@item.Title</span>
                    <h4 class="fw-bold mb-3" style="font-size: 1.3rem;">@item.Subtitle</h4>
                    <a href="/Shop" class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold transition-up shadow-sm">Keşfet <i class="fa fa-arrow-right ms-1" style="font-size: 0.8rem;"></i></a>
                </div>
            </div>
        }

    </div>
</div>

<style>
    .product-offer {
        background-size: 100% auto;
        background-repeat: no-repeat;
    }

        .product-offer:hover {
            background-size: 105% auto;
            box-shadow: 0 10px 20px rgba(0,0,0,0.15) !important;
        }

    .transition-up {
        transition: all 0.3s ease;
    }

        .transition-up:hover {
            transform: translateY(-2px);
        }
</style>