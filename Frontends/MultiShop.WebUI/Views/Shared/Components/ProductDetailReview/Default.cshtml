@model List<ResultCommentDto>

<div class="tab-pane fade" id="tab-pane-3">
    <div class="row">
        <div class="col-md-6">
            <h4 class="mb-4">@(Model?.Count ?? 0) değerlendirme</h4>

            @foreach (var item in Model)
            {
                <div class="media mb-4">
                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://cdn-icons-png.flaticon.com/512/6522/6522516.png" : item.ImageUrl)"
                         alt="Image"
                         class="img-fluid mr-3 mt-1"
                         style="width: 45px; height: 45px; object-fit: cover; border-radius: 50%;">
                    <div class="media-body">
                        <h6>@item.NameSurname<small> - <i>@item.CreatedDate.ToString("dd MMM yyyy")</i></small></h6>
                        <div class="text-primary mb-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= item.Rating)
                                {
                                    <i class="fas fa-star"></i>
                                }
                                else
                                {
                                    <i class="far fa-star"></i>
                                }
                            }
                        </div>
                        <p>@item.Content</p>
                    </div>
                </div>
            }
        </div>

        <div class="col-md-6">
            <h4 class="mb-4">Değerlendirme yapın</h4>
            <small>E-posta adresiniz yayımlanmayacaktır. Zorunlu alanlar * ile işaretlenmiştir</small>

            <form asp-controller="Comment" asp-action="CreateComment" method="post" class="mt-3">
                <div class="form-group">
                    <label for="message">Yorumunuz *</label>
                    <textarea name="Content" cols="30" rows="5" class="form-control" required></textarea>
                </div>
                <div class="form-group">
                    <label for="name">Adınız *</label>
                    <input type="text" name="NameSurname" class="form-control" id="name" required>
                </div>
                <div class="form-group">
                    <label for="email">E-posta Adresiniz *</label>
                    <input type="email" name="Email" class="form-control" id="email" required>
                </div>

                <div class="form-group">
                    <label>Puanınız *</label>
                    <!-- CSS olmadan Bootstrap ve satır içi stiller kullanıyoruz -->
                    <div class="js-star-rating-container" style="font-size: 24px; cursor: pointer; user-select: none;">
                        <input type="radio" id="star1" name="Rating" value="1" class="d-none" required>
                        <label for="star1" class="m-0 pr-1"><i class="fas fa-star text-warning js-star-icon" data-val="1"></i></label>

                        <input type="radio" id="star2" name="Rating" value="2" class="d-none">
                        <label for="star2" class="m-0 pr-1"><i class="fas fa-star text-warning js-star-icon" data-val="2"></i></label>

                        <input type="radio" id="star3" name="Rating" value="3" class="d-none">
                        <label for="star3" class="m-0 pr-1"><i class="fas fa-star text-warning js-star-icon" data-val="3"></i></label>

                        <input type="radio" id="star4" name="Rating" value="4" class="d-none">
                        <label for="star4" class="m-0 pr-1"><i class="fas fa-star text-warning js-star-icon" data-val="4"></i></label>

                        <input type="radio" id="star5" name="Rating" value="5" class="d-none" checked>
                        <label for="star5" class="m-0 pr-1"><i class="fas fa-star text-warning js-star-icon" data-val="5"></i></label>
                    </div>
                </div>

                <input type="hidden" name="ProductId" value="@ViewBag.ProductId" />

                <div class="form-group mb-0">
                    <input type="submit" value="Değerlendirmeyi Gönder" class="btn btn-primary px-3">
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const stars = document.querySelectorAll('.js-star-icon');
        const container = document.querySelector('.js-star-rating-container');
        let currentRating = 5;

        function updateStars(rating) {
            stars.forEach(star => {
                const starVal = parseInt(star.getAttribute('data-val'));
                if (starVal <= rating) {
                    star.classList.remove('far', 'text-muted');   
                    star.classList.add('fas', 'text-warning');    
                } else {
                    star.classList.remove('fas', 'text-warning'); 
                    star.classList.add('far', 'text-muted');      
                }
            });
        }

        stars.forEach(star => {
            star.addEventListener('mouseover', function () {
                const hoverVal = parseInt(this.getAttribute('data-val'));
                updateStars(hoverVal);
            });

            star.addEventListener('click', function () {
                currentRating = parseInt(this.getAttribute('data-val'));
                updateStars(currentRating);
            });
        });

        if (container) {
            container.addEventListener('mouseleave', function () {
                updateStars(currentRating);
            });
        }
    });
</script>