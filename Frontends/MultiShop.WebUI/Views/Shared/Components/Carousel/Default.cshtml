<div class="container-fluid mb-4">
    <div class="row px-xl-5">
        <div class="col-lg-8 mb-4 mb-lg-0">
            <div id="header-carousel" class="carousel slide carousel-fade shadow-sm rounded-4 overflow-hidden" data-bs-ride="carousel">
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#header-carousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                    <button type="button" data-bs-target="#header-carousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
                    <button type="button" data-bs-target="#header-carousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
                </div>
                <div class="carousel-inner">
                    <div class="carousel-item active position-relative" style="height: 430px; background-image: url('https://picsum.photos/id/1025/1200/430'); background-size: cover; background-position: center;">
                        <div class="position-absolute top-0 bottom-0 start-0 end-0 d-flex flex-column align-items-center justify-content-center bg-dark bg-opacity-25 p-3">
                            <div class="p-4 rounded-4 text-center animate__animated animate__fadeInDown" style="max-width: 600px; background: rgba(0, 0, 0, 0.5); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);">
                                <h1 class="display-5 text-white fw-bold mb-3">Erkek Moda</h1>
                                <p class="text-white-50 mb-4 px-md-4">Yeni sezonun en tarz ve seçkin erkek giyim koleksiyonlarını keşfedin. Tarzınızı yansıtacak özel parçalar burada.</p>
                                <a class="btn btn-primary btn-lg rounded-pill px-4 fw-semibold shadow-sm transition-up" href="/Shop">Alışverişe Başla</a>
                            </div>
                        </div>
                    </div>
                    <div class="carousel-item position-relative" style="height: 430px; background-image: url('https://picsum.photos/id/658/1200/430'); background-size: cover; background-position: center;">
                        <div class="position-absolute top-0 bottom-0 start-0 end-0 d-flex flex-column align-items-center justify-content-center bg-dark bg-opacity-25 p-3">
                            <div class="p-4 rounded-4 text-center" style="max-width: 600px; background: rgba(0, 0, 0, 0.5); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);">
                                <h1 class="display-5 text-white fw-bold mb-3">Kadın Moda</h1>
                                <p class="text-white-50 mb-4 px-md-4">Zarafet ve şıklığı bir arada sunan, trendleri belirleyen en yeni kadın koleksiyonları şimdi mağazada.</p>
                                <a class="btn btn-primary btn-lg rounded-pill px-4 fw-semibold shadow-sm transition-up" href="/Shop">Koleksiyonu Gör</a>
                            </div>
                        </div>
                    </div>
                    <div class="carousel-item position-relative" style="height: 430px; background-image: url('https://picsum.photos/id/331/1200/430'); background-size: cover; background-position: center;">
                        <div class="position-absolute top-0 bottom-0 start-0 end-0 d-flex flex-column align-items-center justify-content-center bg-dark bg-opacity-25 p-3">
                            <div class="p-4 rounded-4 text-center" style="max-width: 600px; background: rgba(0, 0, 0, 0.5); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);">
                                <h1 class="display-5 text-white fw-bold mb-3">Çocuk Moda</h1>
                                <p class="text-white-50 mb-4 px-md-4">Miniklerin enerjisine ve rahatlığına uygun, renkli ve eğlenceli yeni sezon çocuk giyim ürünleri.</p>
                                <a class="btn btn-primary btn-lg rounded-pill px-4 fw-semibold shadow-sm transition-up" href="/Shop">Hemen İncele</a>
                            </div>
                        </div>
                    </div>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#header-carousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon rounded-circle p-3 bg-dark bg-opacity-50" aria-hidden="true"></span>
                    <span class="visually-hidden">Önceki</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#header-carousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon rounded-circle p-3 bg-dark bg-opacity-50" aria-hidden="true"></span>
                    <span class="visually-hidden">Sonraki</span>
                </button>
            </div>
        </div>

        @await Component.InvokeAsync("SpecialOffer")
    </div>
</div>