@model List<ResultOfferDiscountDto>

<div class="container-fluid pt-4 pb-3">
	<div class="row px-xl-5">
		@foreach (var item in Model.Where(x => x.IsActive).OrderByDescending(x => x.Id).Take(2))
		{
			<div class="col-md-6 mb-4">
				<div class="position-relative rounded-4 overflow-hidden shadow-sm mid-banner" style="height: 260px;">
					<img class="img-fluid w-100 h-100 banner-img position-absolute top-0 start-0" src="@item.ImageUrl" alt="Sezon Modası" style="object-fit: cover; z-index: 1;">

					<div class="position-absolute top-0 bottom-0 start-0 end-0 d-flex flex-column align-items-start justify-content-center p-5 bg-dark bg-opacity-50 text-white" style="z-index: 2;">
						<span class="badge bg-warning text-dark rounded-pill px-3 py-2 mb-2 fw-bold">@item.Label</span>
						<h3 class="fw-bold mb-2 text-white">@item.Title</h3>
						<p class="text-white-50 small mb-4 d-none d-sm-block">@item.Description.</p>
						<a href="/Shop" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm transition-up">İncelemeye başla</a>
					</div>
				</div>
			</div>
		}
	</div>
</div>

<style>
	.mid-banner .banner-img {
		transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.mid-banner:hover .banner-img {
		transform: scale(1.05);
	}

	.transition-up {
		transition: all 0.3s ease;
	}

		.transition-up:hover {
			transform: translateY(-2px);
		}
</style>