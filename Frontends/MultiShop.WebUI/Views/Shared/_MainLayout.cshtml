<!DOCTYPE html>
<html lang="tr">
<head>
    @await Component.InvokeAsync("Head")

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">

    <link href="~/online-shop-website-template/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">

    <link href="~/online-shop-website-template/css/custom.css" rel="stylesheet">
</head>

<body class="bg-light text-dark">
    @await Component.InvokeAsync("Topbar")
    @await Component.InvokeAsync("Navbar")

    <main class="min-vh-100">
        @RenderBody()
    </main>

    @await Component.InvokeAsync("Footer")

    <a href="#" class="btn btn-primary rounded-circle shadow position-fixed bottom-0 end-0 m-4 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; z-index: 1050; transition: all 0.3s ease; opacity: 0; pointer-events: none;" id="backToTop">
        <i class="fa fa-chevron-up"></i>
    </a>

    @await Component.InvokeAsync("Script")

</body>
</html>