@{
	ViewData["Title"] = "Ürün Listesi";
}

<div class="container-fluid">
	<div class="row px-xl-5">
		<div class="col-12">
			<nav class="breadcrumb bg-light mb-30">
				<a class="breadcrumb-item text-dark" href="/Home/Index">Ana Sayfa</a>
				<span class="breadcrumb-item active">@ViewData["Title"]</span>
			</nav>
		</div>
	</div>
</div>

<div class="container-fluid">
	<div class="row px-xl-5">
		<div class="col-lg-3 col-md-4">

			@await Component.InvokeAsync("PriceFilter")

			@await Component.InvokeAsync("ColorFilter")

			@await Component.InvokeAsync("SizeFilter")

		</div>
		<div class="col-lg-9 col-md-8">
			<div class="row pb-3">

				@await Component.InvokeAsync("ProductListHeader")

				@await Component.InvokeAsync("ProductList", new { categoryId = ViewBag.categoryId })

				@await Component.InvokeAsync("Pagination")

			</div>
		</div>
	</div>
</div>