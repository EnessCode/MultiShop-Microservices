@{
	ViewData["Title"] = "İletişim";
}

<div class="container-fluid pt-3">
	<div class="row px-xl-5">
		<div class="col-12">
			<nav class="breadcrumb bg-white rounded-4 shadow-sm py-3 px-4 mb-4">
				<a class="breadcrumb-item text-dark text-decoration-none fw-medium" href="/Home/Index">Ana Sayfa</a>
				<span class="breadcrumb-item active text-muted">@ViewData["Title"]</span>
			</nav>
		</div>
	</div>
</div>

<div class="container-fluid">
	<div class="row px-xl-5">

		@await Component.InvokeAsync("ContactSendComment")

		@await Component.InvokeAsync("ContactAddress")

	</div>
</div>

<style>
	.gap-3\.5 {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}

	.hover-primary:hover {
		color: var(--bs-primary) !important;
	}

	.transition-up {
		transition: all 0.3s ease;
	}

		.transition-up:hover {
			transform: translateY(-2px);
			box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1) !important;
		}
</style>