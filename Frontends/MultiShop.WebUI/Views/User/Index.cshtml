@model UserDetailViewModel
@{
	Layout = null;
}

<div class="container-fluid pt-4 px-4">
	<div class="row g-4">
		<div class="col-sm-12 col-xl-6">
			<div class="bg-light rounded h-100 p-4">
				<h6 class="mb-4">Profil Bilgilerim</h6>
				<div class="d-flex align-items-center mb-4">
					<img class="rounded-circle" src="~/img/user.jpg" alt="" style="width: 80px; height: 80px;">
					<div class="ms-3">
						<h5 class="mb-0">@Model.Name @Model.Surname</h5>
						<span>@Model.Email</span>
					</div>
				</div>

				<div class="list-group">
					<div class="list-group-item">
						<strong>Kullanıcı Adı:</strong> @Model.Username
					</div>
					<div class="list-group-item">
						<strong>E-Posta:</strong> @Model.Email
					</div>
				</div>

				<div class="mt-4">
					<a href="#" class="btn btn-primary">Düzenle</a>
					<a href="/Auth/LogOut" class="btn btn-danger">Çıkış Yap</a>
				</div>
			</div>
		</div>
	</div>
</div>