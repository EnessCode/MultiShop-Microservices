@{
    Layout = null;
    var activeTab = ViewBag.ActiveTab as string ?? "login";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MultiShop - Giriş & Kayıt</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/auth.css">
</head>
<body class="auth-bg">

    <div class="container d-flex justify-content-center align-items-center min-vh-100">
        <div class="card auth-card shadow-lg border-0 rounded-4" style="max-width: 500px; width: 100%;">
            <div class="card-body p-5">

                <div class="text-center mb-4">
                    <h2 class="fw-bold text-primary"><i class="fa-solid fa-cart-shopping me-2"></i>MultiShop</h2>
                    <p class="text-muted">Hoş geldiniz! Alışverişe başlamak için giriş yapın.</p>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center alert-custom alert-success-custom shadow-sm" role="alert">
                        <i class="fa-solid fa-circle-check fs-3 text-success me-3"></i>
                        <div>
                            <h6 class="alert-heading fw-bold mb-1 text-success">Harika!</h6>
                            <p class="mb-0 small text-dark">@TempData["SuccessMessage"]</p>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center alert-custom alert-danger-custom shadow-sm" role="alert">
                        <i class="fa-solid fa-triangle-exclamation fs-3 text-danger me-3"></i>
                        <div class="flex-grow-1">
                            <h6 class="alert-heading fw-bold mb-1 text-danger">Bir sorun oluştu</h6>
                            <div asp-validation-summary="All" class="custom-validation-summary small text-dark"></div>
                        </div>
                        <button type="button" class="btn-close align-self-start mt-1" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <ul class="nav nav-pills nav-justified mb-4" id="authTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(activeTab == "login" ? "active" : "") rounded-pill fw-semibold" id="login-tab" data-bs-toggle="tab" data-bs-target="#login" type="button" role="tab">Giriş Yap</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(activeTab == "register" ? "active" : "") rounded-pill fw-semibold" id="register-tab" data-bs-toggle="tab" data-bs-target="#register" type="button" role="tab">Kayıt Ol</button>
                    </li>
                </ul>

                <div class="tab-content" id="authTabsContent">

                    <div class="tab-pane fade @(activeTab == "login" ? "show active" : "")" id="login" role="tabpanel">
                        <form asp-controller="Auth" asp-action="Login" method="post">
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" id="loginUsername" name="Username" placeholder="Kullanıcı Adı" required>
                                <label for="loginUsername">Kullanıcı Adı</label>
                            </div>
                            <div class="form-floating mb-3">
                                <input type="password" class="form-control" id="loginPassword" name="Password" placeholder="Şifre" required>
                                <label for="loginPassword">Şifre</label>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="true" id="rememberMe" name="RememberMe">
                                    <label class="form-check-label text-muted" for="rememberMe">Beni Hatırla</label>
                                </div>
                                <a href="/Auth/ForgotPassword" class="text-decoration-none text-primary fw-semibold small">Şifremi Unuttum?</a>
                            </div>
                            <button class="btn btn-primary w-100 py-2 rounded-pill fw-bold shadow-sm" type="submit">Giriş Yap</button>
                        </form>
                    </div>

                    <div class="tab-pane fade @(activeTab == "register" ? "show active" : "")" id="register" role="tabpanel">
                        <form asp-controller="Auth" asp-action="Register" method="post">
                            <div class="row g-2 mb-3">
                                <div class="col-md-6 form-floating">
                                    <input type="text" class="form-control" id="regName" name="Name" placeholder="Ad" required>
                                    <label for="regName" class="ps-3">Ad</label>
                                </div>
                                <div class="col-md-6 form-floating">
                                    <input type="text" class="form-control" id="regSurname" name="Surname" placeholder="Soyad" required>
                                    <label for="regSurname" class="ps-3">Soyad</label>
                                </div>
                            </div>
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" id="regUsername" name="Username" placeholder="Kullanıcı Adı" required>
                                <label for="regUsername">Kullanıcı Adı</label>
                            </div>
                            <div class="form-floating mb-3">
                                <input type="email" class="form-control" id="regEmail" name="Email" placeholder="name@example.com" required>
                                <label for="regEmail">E-posta Adresi</label>
                            </div>
                            <div class="form-floating mb-3">
                                <input type="password" class="form-control" id="regPassword" name="Password" placeholder="Şifre" required>
                                <label for="regPassword">Şifre</label>
                            </div>
                            <div class="form-floating mb-4">
                                <input type="password" class="form-control" id="regConfirmPassword" name="ConfirmPassword" placeholder="Şifre Tekrar" required>
                                <label for="regConfirmPassword">Şifre (Tekrar)</label>
                            </div>
                            <button class="btn btn-dark w-100 py-2 rounded-pill fw-bold shadow-sm" type="submit">Hesap Oluştur</button>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>