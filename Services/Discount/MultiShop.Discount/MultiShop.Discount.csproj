    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>3acf6bbb-a363-4f51-a1fe-b5f5c9e491f2</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
